// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: role is a free string, not a Prisma enum, so it stays flexible.
// Convention used across the app: "ADMIN" | "MANAGER" | "WORKER"

// Models
model User {
  id       String  @id @default(cuid())
  email    String  @unique
  password String
  name     String
  phone    String?
  role     String  @default("WORKER")
  active   Boolean @default(true)

  tasksCreated     Task[]        @relation("TasksCreated")
  assignments      Assignment[]
  comments         Comment[]
  activities       ActivityLog[] @relation("ActorActivities")
  subtasksAssigned Subtask[]
  sessions         Session[]

  attendanceLogs    AttendanceLog[]
  shiftsScheduled   Shift[]            @relation("ShiftsAssignedBy")
  shifts            Shift[]            @relation("ShiftsForUser")
  pushSubscriptions PushSubscription[]
  notifications     Notification[]

  onboardingFormsFilled  OnboardingForm[] @relation("OnboardingFormFilledBy")
  onboardingFormsCreated OnboardingForm[] @relation("OnboardingFormCreatedBy")

  teamMemberships      TeamMember[]
  paymentsRecorded     Payment[]
  quickTasks           QuickTask[]
  proofRequestsCreated ProofRequest[]  @relation("ProofRequestCreatedBy")
  stockMovements       StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A physical site workers can clock in from (Wrapzone T Nagar, Mylapore, Citiprints factory, etc.)
model Location {
  id        String  @id @default(cuid())
  name      String
  latitude  Float
  longitude Float
  radiusM   Int     @default(150) // geofence radius in meters
  address   String?
  active    Boolean @default(true)

  attendanceLogs AttendanceLog[]
  shifts         Shift[]

  createdAt DateTime @default(now())
}

model AttendanceLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  clockInAt  DateTime  @default(now())
  clockOutAt DateTime?

  clockInLat  Float?
  clockInLng  Float?
  clockOutLat Float?
  clockOutLng Float?

  withinGeofence Boolean @default(true)
  method         String  @default("APP") // APP | MANUAL (admin correction)
  note           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, clockInAt])
}

// A planned work shift/window, assigned by an admin/manager to a worker.
model Shift {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("ShiftsForUser", fields: [userId], references: [id])

  assignedById String
  assignedBy   User   @relation("ShiftsAssignedBy", fields: [assignedById], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  date      DateTime // day of the shift (date-only, time zeroed)
  startTime String // "09:00"
  endTime   String // "18:00"
  taskId    String? // optional: shift tied to a specific job
  task      Task?    @relation(fields: [taskId], references: [id])
  notes     String?
  status    String   @default("SCHEDULED") // SCHEDULED | CONFIRMED | COMPLETED | MISSED | CANCELLED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([date])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  fcmToken  String   @unique
  device    String? // "android" | "ios" | "web"
  createdAt DateTime @default(now())
}

// In-app notification feed (also fans out to push via fcmToken above)
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String    @default("GENERAL") // TASK_ASSIGNED | SHIFT_ASSIGNED | TASK_DUE | GENERAL | COMMENT
  linkPath  String? // e.g. "/tasks/abc123"
  taskId    String? // set for COMMENT notifications, used to compute per-task unread counts
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([taskId])
}

model Task {
  id             String    @id @default(cuid())
  title          String
  description    String    @default("")
  status         String    @default("TODO")
  priority       String    @default("MEDIUM")
  startAt        DateTime?
  dueAt          DateTime?
  estimatedHours Float?
  actualHours    Float?
  customer       String? // legacy free-text
  customerId     String?
  customerRef    Customer? @relation(fields: [customerId], references: [id])
  jobNumber      String?
  customFields   String?
  totalAmount    Float? // gated to admins + Accounts team, see canAccessPayments()

  createdById String
  createdBy   User   @relation("TasksCreated", fields: [createdById], references: [id])

  subtasks        Subtask[]
  assignments     Assignment[]
  comments        Comment[]
  attachments     Attachment[]
  activities      ActivityLog[]        @relation("TaskActivities")
  shifts          Shift[]
  despatchItems   DespatchItem[]
  onboardingForms OnboardingForm[]
  teamAssignments TaskTeamAssignment[]
  payments        Payment[]
  proofRequests   ProofRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, dueAt])
  @@index([priority])
  @@index([customerId])
}

// A design proof (one or more files) sent to the customer for approval
// before production. Scoped to the whole task, not a single item -- a task
// with several different products approves them together as one batch.
// No "revoke" concept like OnboardingForm: a rejected request just stays as
// history and staff sends a fresh one; the latest by createdAt is "current".
model ProofRequest {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  token  String @unique
  status String @default("PENDING") // PENDING | APPROVED | REJECTED

  files        String // JSON array: [{ url, name }]
  customerNote String?

  createdById String
  createdBy   User   @relation("ProofRequestCreatedBy", fields: [createdById], references: [id])

  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([taskId])
}

// A line item on a task's despatch list — tracks packing/dispatch/delivery
// per item so fulfillment can be followed up on individually.
model DespatchItem {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  name       String
  quantity   Float
  unit       String  @default("pcs")
  status     String  @default("PENDING_CLIENT_APPROVAL") // PENDING_CLIENT_APPROVAL | PRE_PRODUCTION | PRODUCTION | PACKED | DESPATCHED
  order      Int     @default(0)
  specFields String? // JSON: { category, and category-specific spec keys }

  // A component is just a DespatchItem with a parent -- full reuse of
  // category/specFields/status/stageProgress, no separate model. A
  // top-level item (parentItemId null) can't move to PACKED/DESPATCHED
  // until every one of its components is itself DESPATCHED, see the
  // assembly gate in src/app/api/despatch-items/[id]/route.ts.
  parentItemId String?
  parent       DespatchItem?  @relation("ItemComponents", fields: [parentItemId], references: [id])
  components   DespatchItem[] @relation("ItemComponents")

  // Which route graph this item is following, set once when its route
  // starts (auto-instantiate or explicit choose-route) -- lets both server
  // and client look up outgoing edges from the item's current node without
  // re-deriving the template from category-name matching.
  // onDelete: SetNull -- deleting a route template must not block deleting
  // (or leave dangling) items that already started on it; they just keep
  // their already-visited stageProgress history and lose the live link.
  stageTemplateId String?
  stageTemplate   CategoryStageTemplate? @relation(fields: [stageTemplateId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stageProgress ItemStageProgress[]

  @@index([taskId])
  @@index([parentItemId])
  @@index([stageTemplateId])
}

// One named route through production for a category ("Rigid Boxes" /
// "Laminated"). A category can have several named templates (e.g.
// "Standard" vs "Laminated") for jobs of the same category that take
// different real paths -- see the choose-route flow when >1 template
// exists. Keyed by category NAME, not a foreign key -- built-in categories
// (Rigid Boxes, Cake Boxes, Paper Bags, Stickers, Cards, Invitation,
// Paperboard Boxes, Others) aren't rows in TaskCategory, only admin-added
// custom categories are, so a plain string key covers both.
//
// A route is a branching graph (StageNode + StageEdge), not a flat list --
// built visually in Settings. Must be a DAG with exactly one start node,
// enforced on save (no rework/QC-fail loops -- explicitly out of scope).
model CategoryStageTemplate {
  id       String @id @default(cuid())
  category String
  name     String @default("Standard") // existing single-template-per-category rows backfill here

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  nodes StageNode[]
  edges StageEdge[]
  items DespatchItem[]

  @@unique([category, name])
}

// One stage box in a route's flowchart, positioned for the visual builder.
model StageNode {
  id         String                @id @default(cuid())
  templateId String
  template   CategoryStageTemplate @relation(fields: [templateId], references: [id])

  name    String
  posX    Float   @default(0)
  posY    Float   @default(0)
  isStart Boolean @default(false) // exactly one per template, enforced on save

  outgoingEdges StageEdge[] @relation("EdgeFrom")
  incomingEdges StageEdge[] @relation("EdgeTo")

  @@index([templateId])
}

// A directed connection between two stages in a route's flowchart. A node
// with 2+ outgoing edges is a branch point -- advancing an item past it
// requires an explicit choice (see choose-branch), vs. exactly 1 outgoing
// edge which auto-advances just like a plain linear route.
model StageEdge {
  id         String                @id @default(cuid())
  templateId String
  template   CategoryStageTemplate @relation(fields: [templateId], references: [id])
  fromNodeId String
  toNodeId   String
  from       StageNode             @relation("EdgeFrom", fields: [fromNodeId], references: [id])
  to         StageNode             @relation("EdgeTo", fields: [toNodeId], references: [id])
  label      String? // optional, cosmetic only (e.g. "if laminated")

  @@index([templateId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

// One row per stage an item has actually visited (or is currently on),
// built as-you-go rather than precomputed -- a branching route's future
// path isn't known until each branch choice is made. `order` is the
// sequence this specific item visited stages in (0, 1, 2...); `nodeId`
// identifies which StageNode so advancing can look up its outgoing edges.
model ItemStageProgress {
  id             String       @id @default(cuid())
  despatchItemId String
  despatchItem   DespatchItem @relation(fields: [despatchItemId], references: [id])

  nodeId      String? // the StageNode this row represents
  stageName   String // snapshot -- survives later node renames/deletion
  // @default(0) purely so this column can be added to a table with existing
  // rows without Prisma needing a full database reset -- always set
  // explicitly on create, never actually relied on at runtime.
  order       Int       @default(0)
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([despatchItemId, order])
  @@index([despatchItemId])
}

// An individual payment received against a task's total amount — a job
// paid in installments gets one row per installment. Access is gated to
// admins/managers and members of the "Accounts" team, see canAccessPayments().
model Payment {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  amount     Float
  receivedAt DateTime
  mode       String // CASH | BANK_TRANSFER | UPI | CHEQUE | CARD | OTHER
  notes      String?

  recordedById String
  recordedBy   User   @relation(fields: [recordedById], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId])
}

// A secure, tokenized link sent to a customer (or filled in by staff) to
// collect billing/delivery details for a specific task.
model OnboardingForm {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id])

  token     String   @unique
  status    String   @default("PENDING") // PENDING | SUBMITTED | REVOKED
  expiresAt DateTime

  billingName           String?
  billingEmail          String?
  billingPhone          String?
  billingSecondaryPhone String?
  billingAddress        String?
  gstin                 String?

  deliveryContactName    String?
  deliveryPhone          String?
  deliverySecondaryPhone String?
  deliveryAddress        String?
  deliveryNotes          String?

  submittedAt     DateTime?
  filledByStaffId String?
  filledByStaff   User?     @relation("OnboardingFormFilledBy", fields: [filledByStaffId], references: [id])

  createdById String
  createdBy   User   @relation("OnboardingFormCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Customer {
  id             String  @id @default(cuid())
  name           String
  email          String?
  phone          String? // billing phone
  secondaryPhone String? // billing secondary phone
  company        String?
  address        String? // billing address
  gstin          String?

  deliveryContactName    String?
  deliveryPhone          String?
  deliverySecondaryPhone String?
  deliveryAddress        String?
  deliveryNotes          String?

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TaskCategory {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)

  fields    TaskCategoryField[]
  createdAt DateTime            @default(now())
}

model TaskCategoryField {
  id         String       @id @default(cuid())
  categoryId String
  category   TaskCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  label      String
  type       String // TEXT | NUMBER | DATE | BOOLEAN
  required   Boolean      @default(false)
  order      Int          @default(0)

  createdAt DateTime @default(now())

  @@unique([categoryId, key])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime

  createdAt DateTime @default(now())
}

model Subtask {
  id             String    @id @default(cuid())
  taskId         String
  task           Task      @relation(fields: [taskId], references: [id])
  title          String
  status         String    @default("TODO")
  assigneeId     String?
  assignee       User?     @relation(fields: [assigneeId], references: [id])
  dueAt          DateTime?
  estimatedHours Float?
  actualHours    Float?
  order          Int       @default(0)

  comments    Comment[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Assignment {
  id     String @id @default(cuid())
  taskId String
  userId String
  role   String @default("assignee")

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  // Set when this row was materialized from a team assignment (as opposed
  // to assigning this person directly) — lets team (un)assignment and
  // membership changes find and clean up exactly the rows they created.
  viaTeamId String?
  viaTeam   Team?   @relation(fields: [viaTeamId], references: [id])

  createdAt DateTime @default(now())
}

// A group of users (Accounts, Production, Pre-Production, Delivery, ...)
// that can be assigned to a task as a unit and @mentioned in comments.
model Team {
  id    String @id @default(cuid())
  name  String @unique
  order Int    @default(0)

  members         TeamMember[]
  taskAssignments TaskTeamAssignment[]
  assignments     Assignment[]

  createdAt DateTime @default(now())
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([teamId, userId])
}

// A team assigned to a task — every current member gets a materialized
// Assignment row (see Assignment.viaTeamId) so existing per-user access
// checks work unchanged for team members.
model TaskTeamAssignment {
  id     String @id @default(cuid())
  taskId String
  task   Task   @relation(fields: [taskId], references: [id])
  teamId String
  team   Team   @relation(fields: [teamId], references: [id])

  createdAt DateTime @default(now())

  @@unique([taskId, teamId])
}

model Comment {
  id       String @id @default(cuid())
  body     String
  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  // Polymorphic via nullable FKs
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  subtaskId String?
  subtask   Subtask? @relation(fields: [subtaskId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id   String @id @default(cuid())
  url  String
  name String
  size Int

  // Polymorphic via nullable FKs
  taskId    String?
  task      Task?    @relation(fields: [taskId], references: [id])
  subtaskId String?
  subtask   Subtask? @relation(fields: [subtaskId], references: [id])

  createdAt DateTime @default(now())
}

model ActivityLog {
  id         String  @id @default(cuid())
  entityType String // e.g., "task" | "subtask"
  entityId   String
  action     String // e.g., "STATUS_CHANGE", "ASSIGNED", "UPDATED"
  before     String?
  after      String?

  actorId String
  actor   User   @relation("ActorActivities", fields: [actorId], references: [id])

  // Optional direct task linkage for quicker querying. SetNull (not the
  // default Restrict) so a task's audit history survives its deletion --
  // the whole point of an audit trail is to still show "who deleted this
  // and when" after the task itself is gone.
  taskId String?
  task   Task?   @relation("TaskActivities", fields: [taskId], references: [id], onDelete: SetNull)

  at DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
}

// A personal one-line to-do, separate from the full Task model -- no
// customer, items, or payments, just something to jot down with an optional
// due date/time. Each user only ever sees their own.
model QuickTask {
  id    String    @id @default(cuid())
  text  String
  dueAt DateTime?
  done  Boolean   @default(false)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById, done])
}

// Raw-material stock, tracked as a manual ledger (received/used/wasted/
// adjustment) -- not linked to specific job items yet, just a running
// balance with a reorder threshold.
model Material {
  id           String  @id @default(cuid())
  name         String
  unit         String // "kg", "sheets", "rolls", etc. -- free text, not an enum
  currentStock Float   @default(0)
  reorderPoint Float   @default(0)
  notes        String?

  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StockMovement {
  id         String   @id @default(cuid())
  materialId String
  material   Material @relation(fields: [materialId], references: [id])

  delta  Float // signed: +qty for RECEIVED/ADJUSTMENT-up, -qty for USED/WASTED
  reason String // RECEIVED | USED | WASTED | ADJUSTMENT
  note   String?

  actorId String
  actor   User     @relation(fields: [actorId], references: [id])
  at      DateTime @default(now())

  @@index([materialId, at])
}

// End of schema
